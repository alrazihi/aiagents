# Gemini Agent Toolkit — Environment Configuration
# ================================================
# Copy this file to .env and fill in your values.
# The .env file is NOT committed to version control (see .gitignore).
#
# Required: Google Gemini API key
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-api-key-here-min-10-chars

# Optional overrides (see gemini_agent_toolkit/config.py for defaults)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_INITIAL_BACKOFF_SECONDS=5
GEMINI_MAX_BACKOFF_SECONDS=120
GEMINI_MAX_RETRIES=5
GEMINI_MAX_TURNS=20
GEMINI_MAX_PROMPT_LENGTH=4000
GEMINI_MAX_RESPONSE_LENGTH=8000
GEMINI_COMMAND_TIMEOUT_SECONDS=30
GEMINI_RATE_LIMIT_REQUESTS=60
GEMINI_RATE_LIMIT_WINDOW_SECONDS=60
GEMINI_MAX_TOOL_ITERATIONS=10
GEMINI_ALLOWED_COMMANDS=ls,cat,desc,dir,echo,find,where,grep,rg,head,tail,sort,uniq,wc,tree,diff,jq,xargs,sleep
GEMINI_LOG_LEVEL=INFO
